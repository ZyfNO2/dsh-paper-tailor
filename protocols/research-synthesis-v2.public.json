      "reasonCodes",
      "requiredInputs",
      "requiredValidation",
      "requirements",
      "risks",
      "sourceEvidence",
      "unresolvedConditions",
      "unresolvedFields"
    ]
  },
  "budgets": {
    "connectivity": {
      "maxCalls": 1,
      "maxInputTokensPerCall": 2048,
      "maxOutputTokensPerCall": 512,
      "callTimeoutMs": 120000,
      "totalTimeoutMs": 120000
    },
    "basic": {
      "maxCalls": 4,
      "maxInputTokensPerCall": 16384,
      "maxOutputTokensPerCall": 32768,
      "callTimeoutMs": 120000,
      "totalTimeoutMs": 600000
    },
    "formalPerSample": {
      "maxCalls": 2,
      "maxInputTokensPerCall": 16384,
      "maxOutputTokensPerCall": 8192,
      "callTimeoutMs": 120000,
      "totalTimeoutMs": 300000
    },
    "p7PerCandidateSet": {
      "maxCalls": 0,
      "maxInputTokensPerCall": 0,
      "maxOutputTokensPerCall": 0,
      "callTimeoutMs": 30000,
      "totalTimeoutMs": 30000
    }
  },
  "synthesisLimits": {
    "maxCandidates": 5,
    "maxModulesPerCandidate": 8,
    "contractVersion": 2,
    "ablationPolicy": "leave-one-out-v1"
  },
  "ablationMatrixRule": {
    "contractVersion": 2,
    "policy": "leave-one-out-v1",
    "rows": "baseline, full combination, each combination with one selected module removed; deduplicated",
    "status": "planned",
    "limitation": "Not full factorial; these plans do not prove measured gains or all interactions."
  },
  "scoringPolicy": {
    "policyId": "scoring-policy-v1",
    "rubricVersion": "rubric-v1",
    "weights": {
      "evidence_strength": 30,
      "mechanism_compatibility": 30,
      "mechanism_complementarity": 25,
      "implementation_simplicity": 15
    },
    "levels": [
      0,
      1,
      2
    ],
    "denominator": 200
  },
  "acceptanceCases": {
