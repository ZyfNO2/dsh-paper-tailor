{
  "name": "dsh-paper-beta",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Standalone research workbench and core with an optional DSH plugin compatibility tree.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:tools": "node scripts/release/install-tools.mjs",
    "install:host": "node scripts/release/link-host-modules.mjs",
    "install:all": "npm ci && npm run install:host && npm run install:tools",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend && npm run typecheck:scripts",
    "typecheck:backend": "tsc --noEmit -p packages/evolver/tsconfig.typecheck.json",
    "typecheck:frontend": "tsc --noEmit -p packages/evolver-ui/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.typecheck.json",
    "build": "npm run build:runtime && npm run build:client && npm run build:types && npm run build:node",
    "build:runtime": "node --experimental-strip-types scripts/build-report-offline-runtime.ts --write",
    "build:client": "node packages/evolver-ui/build-client.mjs",
    "build:types": "tsc -p packages/evolver-ui/tsconfig.build.json",
    "build:node": "node scripts/build-node-half.mjs",
    "check:client": "node --experimental-strip-types scripts/build-client-check.ts",
    "verify:beta": "node scripts/release/verify-beta.mjs",
    "verify:host": "node scripts/release/verify-host.mjs",
    "test:domain": "node --import ./scripts/release/host-test-loader.mjs --experimental-strip-types --test tests/integration/external-result.spec.ts tests/integration/general-metrics.spec.ts tests/integration/general-package.spec.ts tests/integration/research-takeover.spec.ts tests/integration/research-takeover-adopt.spec.ts tests/integration/general-wiki-workspace.spec.ts",
    "test:wiring": "node --import ./scripts/release/host-test-loader.mjs --experimental-strip-types --test tests/integration/research-guidance.spec.ts tests/integration/research-cycle-host.spec.ts tests/integration/research-cycle-team.spec.ts tests/integration/general-report.spec.ts tests/integration/general-report-offline.spec.ts tests/frontend-redesign/paper-commands.test.ts tests/frontend-redesign/paper-library.test.ts tests/integration/research-bootstrap-host.spec.ts tests/frontend-redesign/studio-model.test.ts tests/frontend-redesign/studio-ui.test.ts tests/integration/pdf-intake.spec.ts tests/integration/research-skill-entries.spec.ts",
    "test": "npm run test:domain && npm run test:wiring && npm run test:foundations",
    "verify:licenses": "node scripts/release/verify-licenses.mjs",
    "verify:model": "node scripts/release/verify-host.mjs --e2e",
    "test:skills": "node --import ./scripts/release/host-test-loader.mjs --experimental-strip-types --test tests/integration/research-skill-entries.spec.ts tests/integration/general-wiki-workspace.spec.ts",
    "test:foundations": "node --import ./scripts/release/host-test-loader.mjs --test tests/integration/research-foundations.spec.ts tests/integration/research-foundations-host.spec.ts tests/frontend-redesign/research-foundations.test.ts",
    "research:doctor": "node scripts/research-foundations.mjs doctor",
    "research:demo": "node scripts/research-foundations.mjs demo",
    "research": "node --experimental-strip-types packages/research-interfaces/src/cli.ts",
    "research:team": "node research-pack/codex-role.mjs --all",
    "research:mcp": "node --experimental-strip-types packages/research-interfaces/src/mcp.ts",
    "research:workbench": "node --experimental-strip-types packages/research-interfaces/src/legacy-workbench.ts",
    "research:diagnostic": "node --experimental-strip-types packages/research-interfaces/src/workbench.ts",
    "check:research-boundary": "node scripts/check-research-boundary.mjs",
    "check:research-contract": "node scripts/export-research-mcp-contract.mjs --check",
    "typecheck:research": "tsc -p packages/research-interfaces/tsconfig.json && tsc -p apps/workbench/tsconfig.json",
    "build:research": "node scripts/build-research.mjs",
    "build:legacy-workbench": "node scripts/build-legacy-workbench.mjs",
    "research:legacy-workbench": "node packages/research-interfaces/src/legacy-workbench.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "pdfjs-dist": "^6.3.289",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
