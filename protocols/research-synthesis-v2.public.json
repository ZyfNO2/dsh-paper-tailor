{
  "protocolId": "paper-only-v1",
  "version": 1,
  "schemaVersion": 1,
  "split": "diagnostic",
  "sealedSetAvailable": false,
  "requestHashContract": {
    "includes": [
      "protocolRef",
      "sampleKey",
      "budget",
      "phase",
      "inputRefs or taskBrief+cardRefs or candidateSetRef"
    ],
    "excludes": [
      "commandId",
      "evalInvocationId",
      "ownerSessionId"
    ],
    "idempotencyKey": "ownerSessionId + phase + commandId; payload equality is then checked on requestHash"
  },
  "portKinds": {
    "replay": "engineer_authored_replay: exercises the Host machinery, never certifies model capability",
    "authored_draft": "P6 component drafts supplied by the dev case builder, not model output",
    "live": "requires an explicit DSH route binding; absent it, live cases are blocked"
  },
  "formalBlockedReason": "AI assisted diagnostic only, T4 explicitly skipped, independent gold and four real unknown groups absent.",
  "vocabularies": {
    "evidenceStatus": [
      "source_reported",
      "inferred",
      "hypothesis",
      "unknown"
    ],
    "role": [
      "baseline",
      "module",
      "both",
      "unclear"
    ],
    "interventionAxis": [
      "feature_path",
      "loss",
      "training_parameterization",
      "attention_implementation",
      "other"
    ],
    "taskDomain": [
      "vision_segmentation",
      "vision_detection",
      "sequence_modeling",
      "cross_domain",
      "other"
    ],
    "metricDirection": [
      "higher",
      "lower",
      "unknown"
    ],
    "coverage": [
      "complete",
      "partial",
      "insufficient_evidence"
    ],
    "comparability": [
      "unknown",
      "incomparable",
      "context_matched"
    ],
    "compatibilityDecision": [
      "compatible",
      "conditionally_compatible",
      "reject_for_mvp",
      "insufficient_evidence"
    ],
    "candidateDecision": [
      "proposed",
      "conditional",
      "rejected",
      "insufficient_evidence"
    ],
    "reasonCodes": [
      "TASK_MISMATCH",
      "REQUIRED_OPERATOR_ABSENT",
      "REQUIRED_TARGET_ABSENT",
      "SCOPE_EXCLUDED",
      "MECHANISM_CONFLICT",
      "CONDITION_UNRESOLVED",
      "EVIDENCE_MISSING",
      "DISTINCT_INTERVENTION_AXES",
      "SOURCE_SUPPORTED_COMPOSITION"
    ],
    "requirementCategory": [
      "existing_feature_hook",
      "loss_target_transform",
      "parameter_selection",
      "operator_replacement",
      "new_data_annotation",
      "architecture_change",
      "environment_constraint",
      "other"
    ],
    "requirementResolution": [
      "satisfied",
      "unresolved",
      "conflicting",
      "unknown"
    ],
    "bindingRelation": [
      "transforms_features",
      "adds_objective",
      "reparameterizes",
      "replaces_operator",
      "other"
    ],
    "constraintKind": [
      "task_requirement",
      "resource_limit",
      "scope_exclusion"
    ],
    "rankingGroup": [
      "eligible",
      "conditional",
      "not_rankable",
      "excluded"
    ],
    "errorCodes": [
      "INVALID_INPUT",
      "SCHEMA_VIOLATION",
      "SOURCE_MISMATCH",
      "EVIDENCE_INVALID",
      "OWNER_MISMATCH",
      "POLICY_DENIED",
      "IDEMPOTENCY_CONFLICT",
      "DEPENDENCY_NOT_READY",
      "MODEL_UNAVAILABLE",
      "BUDGET_EXHAUSTED",
      "MODEL_TIMEOUT",
      "MODEL_RESPONSE_ERROR",
      "CANCELLED",
      "INTERRUPTED"
    ]
  },
  "fieldClasses": {
    "PaperIdentification": {
      "paperId": "metadata",
      "documentHash": "metadata",
      "taskDomain": "evidence_field",
      "role": "evidence_field",
      "contributedMethods": "evidence_field",
      "builtOnBaselines": "evidence_field",
      "comparisonBaselines": "evidence_field",
      "moduleMentions": "evidence_field",
      "limitations": "evidence_field",
      "reportedResults": "structural_set",
      "ablations": "evidence_field",
      "evidenceSpans": "metadata",
      "coverage": "host_derived",
      "unresolvedFields": "host_derived"
    },
    "ResearchBaselineCard": {
      "id": "metadata",
      "revision": "metadata",
      "paperId": "metadata",
      "name": "evidence_field",
      "taskDomain": "evidence_field",
      "methodSummary": "evidence_field",
      "requirements": "evidence_field",
      "evidenceRefs": "metadata",
      "status": "metadata",
      "producerOperationId": "metadata",
      "documentHash": "metadata"
    },
    "ResearchModuleCard": {
      "id": "metadata",
      "revision": "metadata",
      "paperId": "metadata",
      "name": "evidence_field",
      "mechanism": "evidence_field",
      "interventionAxis": "evidence_field",
      "requirements": "evidence_field",
      "modifies": "evidence_field",
      "expectedOutput": "evidence_field",
      "builtOnBaselines": "evidence_field",
      "limitations": "evidence_field",
      "evidenceRefs": "metadata",
      "status": "metadata",
      "producerOperationId": "metadata",
      "documentHash": "metadata"
    }
  },
  "responseSchema": {
    "topLevelKeys": [
      "identifications",
      "baselineCards",
      "moduleCards",
      "evidenceSpans"
    ],
    "topLevelRule": "Send ONE JSON object whose top-level keys are exactly the four listed in topLevelKeys. Do not nest them under an object named after a type, and do not add taskId or any other key. Send that object alone: no heading, no reasoning preamble and no closing note around it, because anything outside the object makes the answer unparseable.",
    "definitions": {
      "PaperIdentificationDraft": {
        "required": [
          "paperId",
          "taskDomain",
          "role",
          "contributedMethods",
          "builtOnBaselines",
          "comparisonBaselines",
          "moduleMentions",
          "limitations",
          "reportedResults",
          "ablations",
          "evidenceSpans"
        ],
        "additionalProperties": false,
        "note": "documentHash, coverage and unresolvedFields are Host-derived and must not be sent",
        "fieldTypes": {
          "paperId": "string",
          "taskDomain": "EvidenceField",
          "role": "EvidenceField",
          "contributedMethods": "Array<EvidenceField>",
          "builtOnBaselines": "Array<EvidenceField>",
          "comparisonBaselines": "Array<EvidenceField>",
          "moduleMentions": "Array<EvidenceField>",
          "limitations": "Array<EvidenceField>",
          "reportedResults": "Array<ReportedResultDraft>",
          "ablations": "Array<EvidenceField>",
          "evidenceSpans": "Array<string>"
        }
      },
      "ResearchBaselineCardDraft": {
        "required": [
          "paperId",
          "name",
          "taskDomain",
          "methodSummary",
          "requirements"
        ],
        "additionalProperties": false,
        "note": "id, revision, documentHash, producerOperationId, status and evidenceRefs are Host-assembled and must not be sent",
        "fieldTypes": {
          "paperId": "string",
          "name": "EvidenceField",
          "taskDomain": "EvidenceField",
          "methodSummary": "EvidenceField",
          "requirements": "Array<EvidenceField>"
        }
      },
      "ResearchModuleCardDraft": {
        "required": [
          "paperId",
          "name",
          "mechanism",
          "interventionAxis",
          "requirements",
          "modifies",
          "expectedOutput",
          "builtOnBaselines",
          "limitations"
        ],
        "additionalProperties": false,
        "note": "id, revision, documentHash, producerOperationId, status and evidenceRefs are Host-assembled and must not be sent",
        "fieldTypes": {
          "paperId": "string",
          "name": "EvidenceField",
          "mechanism": "EvidenceField",
          "interventionAxis": "EvidenceField",
          "requirements": "Array<EvidenceField>",
          "modifies": "EvidenceField",
          "expectedOutput": "EvidenceField",
          "builtOnBaselines": "Array<EvidenceField>",
          "limitations": "Array<EvidenceField>"
        }
      },
      "SpanDraft": {
        "required": [
          "id",
          "paperId",
          "section",
          "quote"
        ],
        "additionalProperties": false,
        "note": "quote is copied verbatim from the visible section; never send start/end/offsets, the Host resolves them and fails on a non-unique hit, so copy a span long enough to identify one occurrence rather than a short phrase"
      },
      "EvidenceField": {
        "required": [
          "value",
          "status",
          "evidenceRefs",
          "reason"
        ],
        "additionalProperties": false,
        "statusEnum": [
          "source_reported",
          "inferred",
          "hypothesis",
          "unknown"
        ],
        "rules": [
          "status=unknown requires value=null and a non-empty reason",
          "any other status requires a non-null value and at least one evidenceRefs entry naming a SpanDraft id",
          "inferred and hypothesis also require a non-empty reason",
          "reason is null or a non-empty string; an empty string is rejected"
        ]
      },
      "MetricValue": {
        "required": [
          "name",
          "direction"
        ],
        "directionEnum": [
          "higher",
          "lower",
          "unknown"
        ]
      },
      "ReportedResultDraft": {
        "required": [
          "metric",
          "value",
          "unit",
          "dataset",
          "split",
          "baseline",
          "configuration",
          "hardware",
          "comparability",
          "sourceEvidence"
        ],
        "comparabilityEnum": [
          "unknown",
          "incomparable",
          "context_matched"
        ],
        "fieldTypes": {
          "metric": "EvidenceField(MetricValue)",
          "value": "EvidenceField",
          "unit": "EvidenceField",
          "dataset": "EvidenceField",
          "split": "EvidenceField",
          "baseline": "EvidenceField",
          "configuration": "EvidenceField",
          "hardware": "EvidenceField",
          "comparability": "comparability (a bare enum string, never an EvidenceField wrapper)",
          "sourceEvidence": "Array<string> of SpanDraft ids (never an EvidenceField wrapper)"
        }
      }
    },
    "setFieldRule": "a set field is an array of EvidenceField; when the whole set is unknown send exactly one entry with value=null,status=unknown; never mix it with valued entries; an empty array means nothing was extracted this run",
    "setValueShapeRule": "Array<EvidenceField> means a JSON array whose every element is its own complete EvidenceField object. Do not wrap the array inside a single EvidenceField: {\"value\":[{...},{...}],\"status\":...,\"evidenceRefs\":...} is invalid; the correct shape is [{...},{...}]",
    "forbiddenFields": [
      "status other than \"proposed\" on a card",
      "implementationHash",
      "implementationId",
      "inputContract",
      "outputContract",
      "allowedSlots",
      "tensorShape",
      "dtype",
      "channels",
      "slotId",
      "readyReportId",
      "start",
      "end"
    ]
  },
  "synthesisResponseSchema": {
    "topLevelKeys": [
      "candidates"
    ],
    "topLevelRule": "Send ONE JSON object whose only top-level key is candidates, an array of SynthesisCandidateDraft. Do not nest the array under an object named after a type. Send that object alone: no heading, no reasoning preamble and no closing note around it, because anything outside the object makes the answer unparseable.",
    "definitions": {
      "SynthesisCandidateDraft": {
        "required": [
          "id",
          "baselineCardRef",
          "moduleCardRefs",
          "compatibility",
          "mechanismHypothesis",
          "conceptualBindings",
          "expectedEffects",
          "risks",
          "requiredValidation",
          "evidenceRefs",
          "decision"
        ],
        "additionalProperties": false,
        "note": "candidateHash, taskBriefHash, ablationMatrix and performanceStatus are Host-derived and must not be sent",
        "fieldTypes": {
          "id": "string",
          "baselineCardRef": "CardRef",
          "moduleCardRefs": "Array<CardRef>",
          "compatibility": "CompatibilityAssessmentDraft",
          "mechanismHypothesis": "EvidenceField",
          "conceptualBindings": "Array<ConceptualBindingDraft>",
          "expectedEffects": "Array<EvidenceField>",
          "risks": "Array<EvidenceField>",
          "requiredValidation": "Array<EvidenceField>",
          "evidenceRefs": "Array<string>",
          "decision": "candidateDecision"
        }
      },
      "CardRef": {
        "required": [
          "id",
          "revision",
          "sha256",
          "producerOperationId"
        ],
        "additionalProperties": false,
        "note": "copy a CardRef verbatim from the PUBLISHED CARDS block; an invented id, revision or sha256 is refused by the Host"
      },
      "CompatibilityAssessmentDraft": {
        "required": [
          "baselineCardRef",
          "moduleCardRefs",
          "scope",
          "decision",
          "requirements",
          "unresolvedConditions",
          "reasonCodes",
          "rationale",
          "evidenceRefs",
          "interfaceStatus"
        ],
        "additionalProperties": false,
        "scopeEnum": [
          "mechanism_only"
        ],
        "interfaceStatusEnum": [
          "NOT_VERIFIED"
        ],
        "decisionEnum": [
          "compatible",
          "conditionally_compatible",
          "reject_for_mvp",
          "insufficient_evidence"
        ],
        "fieldTypes": {
          "baselineCardRef": "CardRef",
          "moduleCardRefs": "Array<CardRef>",
          "requirements": "Array<RequirementDraft>",
          "unresolvedConditions": "Array<string>",
          "reasonCodes": "Array<reasonCode>",
          "rationale": "string",
          "evidenceRefs": "Array<string>"
        }
      },
      "RequirementDraft": {
        "required": [
          "id",
          "category",
          "description",
          "resolution",
          "basisRefs"
        ],
        "additionalProperties": false,
        "categoryEnum": [
          "existing_feature_hook",
          "loss_target_transform",
          "parameter_selection",
          "operator_replacement",
          "new_data_annotation",
          "architecture_change",
          "environment_constraint",
          "other"
        ],
        "resolutionEnum": [
          "satisfied",
          "unresolved",
          "conflicting",
          "unknown"
        ],
        "fieldTypes": {
          "description": "EvidenceField",
          "basisRefs": "Array<string>"
        }
      },
      "ConceptualBindingDraft": {
        "required": [
          "moduleRef",
          "axis",
          "targetConcept",
          "relation",
          "requiredInputs"
        ],
        "additionalProperties": false,
        "axisEnum": [
          "feature_path",
          "loss",
          "training_parameterization",
          "attention_implementation",
          "other"
        ],
        "relationEnum": [
          "transforms_features",
          "adds_objective",
          "reparameterizes",
          "replaces_operator",
          "other"
        ],
        "fieldTypes": {
          "moduleRef": "CardRef",
          "targetConcept": "EvidenceField",
          "requiredInputs": "Array<EvidenceField>"
        }
      },
      "EvidenceField": {
        "required": [
          "value",
          "status",
          "evidenceRefs",
          "reason"
        ],
        "additionalProperties": false,
        "statusEnum": [
          "source_reported",
          "inferred",
          "hypothesis",
          "unknown"
        ],
        "rules": [
          "status=unknown requires value=null and a non-empty reason",
          "any other status requires a non-null value and at least one evidenceRefs entry",
          "inferred and hypothesis also require a non-empty reason",
          "reason is null or a non-empty string; an empty string is rejected"
        ]
      }
    },
    "decisionRule": "compatibility.decision alone fixes the candidate decision: compatible->proposed, conditionally_compatible->conditional, reject_for_mvp->rejected, insufficient_evidence->insufficient_evidence. mechanismHypothesis must carry status=hypothesis on a proposed/conditional candidate and status=unknown on a rejected/insufficient one, and risks plus requiredValidation must each hold at least one valued entry when the candidate is proposed or conditional.",
    "evidenceRefRule": "P6 cannot introduce quotations: every evidenceRefs and basisRefs entry must name a span id that is already attached to one of the published cards you bind.",
    "setFieldRule": "a set field is an array of EvidenceField; when the whole set is unknown send exactly one entry with value=null,status=unknown; never mix it with valued entries",
    "setValueShapeRule": "Array<EvidenceField> means a JSON array whose every element is its own complete EvidenceField object, not one EvidenceField whose value is an array.",
    "forbiddenFields": [
      "implementationHash",
      "implementationId",
      "inputContract",
      "outputContract",
      "allowedSlots",
      "tensorShape",
      "dtype",
      "channels",
      "slotId",
      "readyReportId",
      "any predicted metric value"
    ]
  },
  "hashProtocol": {
    "canonicalEncoding": "canonical-json-v1",
    "textNormalization": "paper-text-v1",
    "location": "Unicode code point half-open [start,end) relative to one section",
    "requestHashFields": [
      "protocolRef",
      "sampleKey",
      "budget",
      "phase",
      "inputs or card refs"
    ],
    "requestHashExcludes": [
      "commandId",
      "evalInvocationId",
      "ownerSessionId"
    ],
    "idempotencyKey": "ownerSessionId + phase + commandId, then compare requestHash",
    "typeNames": [
      "request",
      "candidate",
      "corpus",
      "policy",
      "report",
      "paper-document",
      "card-identity",
      "task-brief",
