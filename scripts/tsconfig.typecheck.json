{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "typeRoots": ["../tools/ts-toolchain/node_modules/@types"],
    "paths": {
      "@deepseek-ai/cordis": ["../tools/vendor/gen/cordis/src/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["../tools/vendor/gen/dsh-tools/lib/index.d.ts"],
