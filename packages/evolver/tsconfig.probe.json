{
    "include":  [
                    ".probe-ts/**/*.ts"
                ],
    "compilerOptions":  {
                            "noEmit":  true,
                            "skipLibCheck":  true,
                            "typeRoots":  [
                                              "../../tools/ts-toolchain/node_modules/@types"
                                          ],
                            "module":  "nodenext",
